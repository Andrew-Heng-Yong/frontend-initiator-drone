# Copy to Scripts/signing.local and fill in, then re-run
# python3 Scripts/generate_xcodeproj.py
#
# signing.local is git-ignored. It exists because setting a team in Xcode's
# Signing & Capabilities pane writes into project.pbxproj, which the generator
# overwrites — so the setting would disappear the next time anyone regenerated
# the project.

# Your 10-character Apple Developer Team ID.
#   Paid account:  developer.apple.com/account -> Membership -> Team ID
#   Free Apple ID: Xcode -> Settings -> Accounts -> select your Apple ID; the
#                  Team ID is shown next to your "(Personal Team)" row.
DEVELOPMENT_TEAM=ABCDE12345

# Bundle IDs are globally unique. The default (com.initiatordrone.app) may
# already be taken, which shows up as "Failed to register bundle identifier".
# Use your own reverse-DNS prefix.
PRODUCT_BUNDLE_IDENTIFIER=com.yourname.initiatordrone
